{
    "compilerOptions": {
        "moduleResolution": "node",
        "module": "ES2015",
        "lib": [
            "es2016",
            "dom"
        ],
        "esModuleInterop": true,
        "target": "es2016",
        "newLine": "LF",
        "declaration": true,
        "declarationDir": "dist",
        "emitDeclarationOnly": true,
        "noImplicitAny": true,
        "noImplicitReturns": true,
        "strictNullChecks": true
    },
    "include": [
        "src/imager-ts/**/*",
        "src/imager-ts-server/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}
