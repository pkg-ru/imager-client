{
    "name": "@pkg-ru/imager-vue",
    "version": "2.0.2",
    "description": "Vue 3-компоненты для микросервиса Imager: ImagerPlugin, ImagerProvider, ImagerAssets, ImagerAsset",
    "license": "GPL-3.0",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "author": {
        "name": "Vladislav Altukhov",
        "url": "https://altuh.ru/about"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/pkg-ru/imager-client"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "README.md"
    ],
    "scripts": {
        "build": "rollup -c rollup.config.js",
        "prepublishOnly": "npm run build",
        "test": "tsc -p tsconfig.test.json && node dist-test/imager-client/packages/vue/test/test.js"
    },
    "peerDependencies": {
        "imager-client": ">=2.0.2",
        "vue": ">=3.2.0"
    },
    "peerDependenciesMeta": {
        "imager-client": {
            "optional": true
        }
    },
    "devDependencies": {
        "@rollup/plugin-commonjs": "^28.0.0",
        "@rollup/plugin-node-resolve": "^16.0.0",
        "@rollup/plugin-typescript": "^12.3.0",
        "imager-client": "file:../..",
        "rollup": "^4.36.0",
        "rollup-plugin-dts": "^6.1.0",
        "typescript": "^5.8.0",
        "vue": "^3.5.0"
    }
}
