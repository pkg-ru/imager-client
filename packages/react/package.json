{
    "name": "@pkg-ru/imager-react",
    "version": "2.0.1",
    "description": "React-компоненты для микросервиса Imager: ImagerPlugin, ImagerProvider, ImagerAssets, ImagerAsset",
    "license": "GPL-3.0",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "README.md"
    ],
    "scripts": {
        "build": "rollup -c rollup.config.js",
        "prepublishOnly": "npm run build",
        "test": "tsc -p tsconfig.test.json && node dist-test/imager-client/packages/react/test/test.js"
    },
    "peerDependencies": {
        "imager-client": ">=2.0.0",
        "react": ">=17.0.0"
    },
    "peerDependenciesMeta": {
        "imager-client": {
            "optional": true
        }
    },
    "devDependencies": {
        "@rollup/plugin-commonjs": "^28.0.0",
        "@rollup/plugin-node-resolve": "^16.0.0",
        "@rollup/plugin-typescript": "^12.3.0",
        "@types/react": "^18.0.0",
        "@types/react-dom": "^18.0.0",
        "imager-client": "file:../..",
        "react-dom": "^18.0.0",
        "rollup": "^4.36.0",
        "rollup-plugin-dts": "^6.1.0",
        "typescript": "^5.8.0"
    }
}
