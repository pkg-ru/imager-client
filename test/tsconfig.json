{
    "compilerOptions": {
        "module": "CommonJS",
        "moduleResolution": "node",
        "target": "ES2020",
        "lib": ["es2020", "dom"],
        "esModuleInterop": true,
        "strict": true,
        "noImplicitAny": true,
        "noImplicitReturns": true,
        "strictNullChecks": true,
        "resolveJsonModule": true,
        "rootDir": "..",
        "outDir": "dist",
        "types": ["node"]
    },
    "include": [
        "test.ts",
        "../src/imager-ts/**/*.ts",
        "../src/imager-ts-server/**/*.ts"
    ],
    "exclude": ["node_modules", "dist"]
}
